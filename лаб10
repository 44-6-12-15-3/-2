#include <iostream>
#include <string>
#include <vector>

class Vehicle {
protected:
    std::string model;
    int speed;
    int maxSpeed;
    std::string licensePlate;
    
public:
    Vehicle(std::string m, int maxS, std::string plate = "Не указан") 
        : model(m), speed(0), maxSpeed(maxS), licensePlate(plate) {
        std::cout << "Конструктор Vehicle: " << model << std::endl;
    }
    
    virtual ~Vehicle() {
        std::cout << "Деструктор Vehicle: " << model << std::endl;
    }
    
    virtual void accelerate(int increment) {
        speed += increment;
        if (speed > maxSpeed) speed = maxSpeed;
        std::cout << model << " разогнался до " << speed << " км/ч" << std::endl;
    }
    
    virtual void brake(int decrement) {
        speed -= decrement;
        if (speed < 0) speed = 0;
        std::cout << model << " замедлился до " << speed << " км/ч" << std::endl;
    }
    
    virtual void displayInfo() const {
        std::cout << "Модель: " << model << ", Скорость: " << speed 
                  << "/" << maxSpeed << " км/ч, Номер: " << licensePlate;
    }
    
    std::string getModel() const { return model; }
    int getSpeed() const { return speed; }
    int getMaxSpeed() const { return maxSpeed; }
};

class PublicTransport {
protected:
    int routeNumber;
    int passengerCapacity;
    int currentPassengers;
    
public:
    PublicTransport(int route, int capacity) 
        : routeNumber(route), passengerCapacity(capacity), currentPassengers(0) {
        std::cout << "Конструктор PublicTransport: маршрут №" << routeNumber 
                  << ", вместимость " << passengerCapacity << std::endl;
    }
    
    virtual ~PublicTransport() {
        std::cout << "Деструктор PublicTransport: маршрут №" << routeNumber << std::endl;
    }
    
    virtual void boardPassengers(int count) {
        int boarding = std::min(count, passengerCapacity - currentPassengers);
        currentPassengers += boarding;
        std::cout << "Посадка " << boarding << " пассажиров. Всего: " 
                  << currentPassengers << "/" << passengerCapacity << std::endl;
        if (boarding < count) {
            std::cout << "Предупреждение: " << (count - boarding) 
                      << " пассажиров не поместились!" << std::endl;
        }
    }
    
    virtual void disembarkPassengers(int count) {
        int disembarking = std::min(count, currentPassengers);
        currentPassengers -= disembarking;
        std::cout << "Высадка " << disembarking << " пассажиров. Осталось: " 
                  << currentPassengers << std::endl;
    }
    
    virtual void displayPublicInfo() const {
        std::cout << "Маршрут №" << routeNumber << ", Пассажиры: " 
                  << currentPassengers << "/" << passengerCapacity;
    }
    
    int getRouteNumber() const { return routeNumber; }
    int getPassengerCount() const { return currentPassengers; }
};

class Bus : public PublicTransport, public virtual Vehicle {
private:
    std::string fuelType;
    
public:
    Bus(std::string model, int maxSpeed, std::string plate, 
        int route, int capacity, std::string fuel)
        : Vehicle(model, maxSpeed, plate), 
          PublicTransport(route, capacity),
          fuelType(fuel) {
        std::cout << "Конструктор Bus: " << model << ", топливо: " << fuel << std::endl;
    }
    
    ~Bus() {
        std::cout << "Деструктор Bus: " << getModel() << std::endl;
    }

    void displayInfo() const override {
        Vehicle::displayInfo();
        std::cout << ", Тип: Автобус, Топливо: " << fuelType;
    }

    void displayPublicInfo() const override {
        PublicTransport::displayPublicInfo();
        std::cout << ", Транспорт: Автобус (" << fuelType << ")";
    }

    void displayFullInfo() const {
        displayInfo();
        std::cout << ", ";
        displayPublicInfo();
        std::cout << std::endl;
    }
    
    // Специфический метод для автобуса
    void refuel(int liters) {
        std::cout << "Автобус " << getModel() << " заправлен на " 
                  << liters << " литров " << fuelType << std::endl;
    }
    
    std::string getFuelType() const { return fuelType; }
};

class Tram : public PublicTransport, public virtual Vehicle {
private:
    double electricLineVoltage;
    
public:
    Tram(std::string model, int maxSpeed, std::string plate,
         int route, int capacity, double voltage)
        : Vehicle(model, maxSpeed, plate),
          PublicTransport(route, capacity),
          electricLineVoltage(voltage) {
        std::cout << "Конструктор Tram: " << model << ", напряжение " 
                  << voltage << " В" << std::endl;
    }
    
    ~Tram() {
        std::cout << "Деструктор Tram: " << getModel() << std::endl;
    }

    void accelerate(int increment) override {
        std::cout << "[Трамвай] ";
        Vehicle::accelerate(increment * 0.8);
    }
    
    void displayInfo() const override {
        Vehicle::displayInfo();
        std::cout << ", Тип: Трамвай, Напряжение: " << electricLineVoltage << " В";
    }

    void displayPublicInfo() const override {
        PublicTransport::displayPublicInfo();
        std::cout << ", Транспорт: Трамвай (контактная сеть)";
    }

    void displayFullInfo() const {
        displayInfo();
        std::cout << ", ";
        displayPublicInfo();
        std::cout << std::endl;
    }

    void connectToLine() {
        std::cout << "Трамвай " << getModel() << " подключен к линии " 
                  << electricLineVoltage << " В" << std::endl;
    }
    
    double getVoltage() const { return electricLineVoltage; }
};

class Trolleybus : public PublicTransport, public virtual Vehicle {
private:
    double electricLineVoltage;
    std::string batteryType;  // Тип аккумулятора для автономного хода
    
public:
    Trolleybus(std::string model, int maxSpeed, std::string plate,
               int route, int capacity, double voltage, std::string battery)
        : Vehicle(model, maxSpeed, plate),
          PublicTransport(route, capacity),
          electricLineVoltage(voltage), batteryType(battery) {
        std::cout << "Конструктор Trolleybus: " << model << std::endl;
    }
    
    void displayFullInfo() const {
        Vehicle::displayInfo();
        std::cout << ", Тип: Троллейбус, Напряжение: " << electricLineVoltage 
                  << " В, АКБ: " << batteryType << ", ";
        PublicTransport::displayPublicInfo();
        std::cout << std::endl;
    }
};

int main() {
    std::cout << "=== ИЕРАРХИЯ ОБЩЕСТВЕННОГО ТРАНСПОРТА ===\n\n";
    
    std::cout << "--- СОЗДАНИЕ АВТОБУСА ---\n";
    Bus bus1("MAZ-203", 110, "A001AA", 12, 80, "Дизель");
