    std::cout << "=== ПОЛИМОРФИЗМ ЧЕРЕЗ VEHICLE ===\n";
    std::vector<Vehicle*> vehicles;
    vehicles.push_back(&bus1);
    vehicles.push_back(&tram1);
    
    for (Vehicle* v : vehicles) {
        v->displayInfo();
        std::cout << std::endl;
    }
    
    std::cout << "\n=== ПОЛИМОРФИЗМ ЧЕРЕЗ PUBLICTRANSPORT ===\n";
    std::vector<PublicTransport*> transports;
    transports.push_back(&bus1);
    transports.push_back(&tram1);
    
    for (PublicTransport* pt : transports) {
        pt->displayPublicInfo();
