    std::cout << "\nАВТОБУСЫ:\n";
    for (Bus* b : buses) {
        b->displayFullInfo();
    }
    
    std::cout << "\nТРАМВАИ:\n";
    for (Tram* t : trams) {
        t->displayFullInfo();
    }
    
    for (Bus* b : buses) delete b;
    for (Tram* t : trams) delete t;
    
    std::cout << "\n=== РАЗМЕРЫ ОБЪЕКТОВ ===\n";
    std::cout << "Размер Vehicle: " << sizeof(Vehicle) << " байт" << std::endl;
    std::cout << "Размер PublicTransport: " << sizeof(PublicTransport) << " байт" << std::endl;
    std::cout << "Размер Bus: " << sizeof(Bus) << " байт" << std::endl;
    std::cout << "Размер Tram: " << sizeof(Tram) << " байт" << std::endl;
    
    return 0;
}
